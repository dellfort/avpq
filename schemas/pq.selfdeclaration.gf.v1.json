{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://avpq.example.de/schemas/pq.selfdeclaration.gf.v1.json",
  "title": "Eigenerklärung - Geschäftsführer",
  "description": "JSON Schema für Eigenerklärungen von Geschäftsführern (natürliche Personen) im Rahmen der AVPQ",
  "type": "object",
  "properties": {
    "declarationId": {
      "type": "string",
      "description": "Eindeutige ID der Eigenerklärung"
    },
    "managingDirector": {
      "type": "object",
      "description": "Angaben zum Geschäftsführer",
      "properties": {
        "firstName": {
          "type": "string",
          "description": "Vorname"
        },
        "lastName": {
          "type": "string",
          "description": "Nachname"
        },
        "dateOfBirth": {
          "type": "string",
          "format": "date",
          "description": "Geburtsdatum (YYYY-MM-DD)"
        }
      },
      "required": [
        "firstName",
        "lastName",
        "dateOfBirth"
      ]
    },
    "declaration": {
      "type": "object",
      "description": "Erklärungen und Bestätigungen",
      "properties": {
        "noCriminalOffenses": {
          "type": "boolean",
          "description": "Keine Eintragungen im Führungszeugnis"
        },
        "consent": {
          "type": "boolean",
          "description": "Zustimmung zur Verarbeitung personenbezogener Daten"
        }
      },
      "required": [
        "noCriminalOffenses",
        "consent"
      ]
    }
  },
  "required": [
    "declarationId",
    "managingDirector",
    "declaration"
  ],
  "additionalProperties": false
}}
